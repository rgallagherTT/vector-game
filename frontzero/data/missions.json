{
  "meta": { "note": "Campaign: The Accord vs the Iron Mandate. Each mission is a script: steps (text, actions, trigger, optional fail, checkpoint) plus free-running events. Positions are [x, z] on the mission's map; a third element 'top' snaps to the highest surface (roofs, decks). See §EVENTS in index.html for every trigger and action type." },
  "list": [
    {
      "id": "m1", "name": "Hold the Line", "map": "dustwater", "variant": "dusk", "start": [-70, 60], "yaw": 2.3, "squad": 3, "par": 900,
      "brief": "An Iron Mandate column is driving on Dustwater from the FOB to the south-east. The Kharavani militia needs time to evacuate the town. Hold the market square, break the column, and do not let their field officer get back to the FOB.",
      "debrief": "Dustwater held. The officer's maps show the Mandate pushing supplies through Selvara's river country. That is where we go next.",
      "loadout": { "throwables": { "frag": 3, "smoke": 2 } },
      "steps": [
        { "text": "Reach the market square", "actions": [ { "do": "cine", "title": "HOLD THE LINE", "sub": "Dustwater, Kharavan · 18:30" }, { "do": "radio", "who": "Command", "text": "Mandate column inbound from the FOB. Get to the market and dig in — the militia needs ten minutes." }, { "do": "marker", "id": "m", "pos": [0, 0], "label": "Market square" } ], "trigger": { "type": "reach", "pos": [0, 0], "r": 30 } },
        { "text": "Hold the market — first wave", "checkpoint": true, "actions": [ { "do": "unmarker", "id": "m" }, { "do": "marker", "id": "d", "pos": [0, 0], "label": "Hold" }, { "do": "spawn", "n": 8, "pos": [260, -260], "r": 20, "team": 1, "tag": "w1", "difficulty": "regular", "goal": { "type": "attack", "pos": [0, 0], "r": 25 } }, { "do": "radio", "who": "Command", "text": "Contacts south-east. Here they come." } ], "trigger": { "type": "all", "of": [ { "type": "timer", "t": 45 }, { "type": "alive", "tag": "w1", "max": 1 } ] } },
        { "text": "Hold the market — armoured push", "actions": [ { "do": "spawn", "n": 8, "pos": [200, -320], "r": 20, "team": 1, "tag": "w2", "difficulty": "regular", "goal": { "type": "attack", "pos": [0, 0], "r": 25 } }, { "do": "spawnVehicle", "id": "speeder_buggy", "pos": [300, -380], "team": 1, "tag": "w2v", "crew": 2, "goal": { "type": "attack", "pos": [0, 0], "r": 20 } }, { "do": "radio", "who": "Command", "text": "Gun buggy on the main road. Engineers, use your launchers." } ], "trigger": { "type": "all", "of": [ { "type": "timer", "t": 45 }, { "type": "alive", "tag": "w2", "max": 1 } ] } },
        { "text": "Chase down the Mandate officer", "checkpoint": true, "actions": [ { "do": "unmarker", "id": "d" }, { "do": "radio", "who": "Militia", "text": "Their officer is running! Speeder bike, heading back to the FOB!" }, { "do": "spawnVehicle", "id": "speeder_bike", "pos": [130, -110], "yaw": 2.4, "team": 1, "tag": "officer", "crew": 1, "goal": { "type": "move", "pos": [700, -720], "r": 15 } }, { "do": "spawnVehicle", "id": "speeder_bike", "pos": [12, -18], "yaw": 2.4, "team": 0, "player": true }, { "do": "marker", "id": "o", "pos": [700, -720], "label": "FOB — stop them before here" } ], "trigger": { "type": "any", "of": [ { "type": "destroy", "vtag": "officer" }, { "type": "kill", "tag": "officer_crew" } ] }, "fail": { "type": "vehicleAt", "vtag": "officer", "pos": [700, -720], "r": 60 }, "failText": "The officer reached the FOB" },
        { "text": "Officer down", "actions": [ { "do": "unmarker", "id": "o" }, { "do": "radio", "who": "Command", "text": "Good work. The town is clear. Grab their map case and come home." } ], "trigger": { "type": "timer", "t": 5 }, "after": [ { "do": "win" } ] }
      ]
    },
    {
      "id": "m2", "name": "Downriver", "map": "rivercut", "variant": "fog", "start": [-195, -1010], "yaw": 0, "squad": 3, "par": 1100,
      "brief": "Selvara's river carries Mandate supplies to a radar post they have built in the old temple. Run the river by patrol boat past the bank positions, land below the temple, and plant a jammer in its courtyard.",
      "debrief": "The temple radar is jammed. Its logs point north — to a research station in Nordheim's ice fields.",
      "steps": [
        { "text": "Run the river south", "actions": [ { "do": "cine", "title": "DOWNRIVER", "sub": "Rivercut, Selvara · 06:30" }, { "do": "spawnVehicle", "id": "patrol_boat", "pos": [-192, -990], "yaw": 0, "team": 0, "tag": "boat", "player": true }, { "do": "host", "fn": "squadBoard", "vtag": "boat" }, { "do": "radio", "who": "Command", "text": "Full throttle, stay mid-channel. They have positions on both banks." }, { "do": "marker", "id": "b", "pos": [-150, -420], "label": "Bend" }, { "do": "spawn", "n": 4, "pos": [-70, -700], "r": 12, "team": 1, "tag": "bank1", "goal": { "type": "defend", "pos": [-70, -700], "r": 15 } }, { "do": "spawn", "n": 4, "pos": [-290, -520], "r": 12, "team": 1, "tag": "bank2", "goal": { "type": "defend", "pos": [-290, -520], "r": 15 } }, { "do": "spawnVehicle", "id": "patrol_boat", "pos": [-150, -380], "yaw": 3.14, "team": 1, "tag": "eboat", "crew": 2, "goal": { "type": "attack", "pos": [-185, -800], "r": 30 } } ], "trigger": { "type": "reach", "pos": [-150, -420], "r": 70 } },
        { "text": "Reach the temple landing", "checkpoint": true, "actions": [ { "do": "unmarker", "id": "b" }, { "do": "marker", "id": "l", "pos": [-95, 290], "label": "Landing" }, { "do": "spawn", "n": 5, "pos": [10, -60], "r": 15, "team": 1, "tag": "bank3", "goal": { "type": "defend", "pos": [10, -60], "r": 15 } }, { "do": "spawnVehicle", "id": "patrol_boat", "pos": [-110, 100], "yaw": 3.14, "team": 1, "tag": "eboat2", "crew": 2, "goal": { "type": "attack", "pos": [-130, -150], "r": 30 } } ], "trigger": { "type": "reach", "pos": [-95, 290], "r": 50 } },
        { "text": "Clear the temple", "checkpoint": true, "actions": [ { "do": "unmarker", "id": "l" }, { "do": "host", "fn": "squadDismount" }, { "do": "radio", "who": "Command", "text": "Take the ridge above the temple and rappel into the courtyard. Hit them from above." }, { "do": "marker", "id": "t", "pos": [-500, 300], "label": "Temple" }, { "do": "spawn", "n": 9, "pos": [-500, 300], "r": 35, "team": 1, "tag": "temple", "difficulty": "regular", "goal": { "type": "defend", "pos": [-500, 300], "r": 30 } } ], "trigger": { "type": "alive", "tag": "temple", "max": 1 } },
        { "text": "Plant the jammer", "actions": [ { "do": "interact", "pos": [-500, 300], "label": "Plant jammer", "hold": 3, "flag": "jam", "text": "Jammer running" } ], "trigger": { "type": "flag", "name": "jam" } },
        { "text": "Extract at the river port", "checkpoint": true, "actions": [ { "do": "unmarker", "id": "t" }, { "do": "marker", "id": "x", "pos": [320, 900], "label": "River port" }, { "do": "radio", "who": "Command", "text": "Boat waiting at the river port. Move." }, { "do": "spawn", "n": 6, "pos": [800, -800], "r": 20, "team": 1, "tag": "chase", "hunt": true } ], "trigger": { "type": "reach", "pos": [320, 900], "r": 45 }, "after": [ { "do": "win" } ] }
      ]
    },
    {
      "id": "m3", "name": "White Noise", "map": "icebreak", "variant": "blizzard", "hour": 0.5, "start": [-500, 400], "yaw": 1.2, "squad": 3, "par": 1100,
      "brief": "A night raid in a blizzard. The Mandate research station at Icebreak is building guidance chips for their missiles. Thermal optics will see through the snow — theirs will not. Steal the research, then blind the station by bringing down its radar dome.",
      "debrief": "The research names a dam in Valmora: the Mandate plans to hold the valley hostage. We are going to take that option away from them.",
      "loadout": { "optic": "thermal", "throwables": { "c4": 2, "smoke": 2 } },
      "steps": [
        { "text": "Approach the research station", "actions": [ { "do": "cine", "title": "WHITE NOISE", "sub": "Icebreak, Nordheim · 00:30" }, { "do": "radio", "who": "Command", "text": "Visibility is near zero. Use thermals, stay off the roads." }, { "do": "marker", "id": "a", "pos": [150, 230], "label": "Station edge" }, { "do": "spawn", "n": 4, "pos": [-120, 300], "r": 25, "team": 1, "tag": "p1", "goal": { "type": "defend", "pos": [-120, 300], "r": 30 } } ], "trigger": { "type": "reach", "pos": [150, 230], "r": 70 } },
        { "text": "Clear the labs", "checkpoint": true, "actions": [ { "do": "unmarker", "id": "a" }, { "do": "marker", "id": "l", "pos": [330, 200], "label": "Labs" }, { "do": "spawn", "n": 10, "pos": [330, 200], "r": 45, "team": 1, "tag": "lab", "difficulty": "regular", "goal": { "type": "defend", "pos": [330, 200], "r": 40 } } ], "trigger": { "type": "alive", "tag": "lab", "max": 2 } },
        { "text": "Download the research", "actions": [ { "do": "interact", "pos": [330, 200], "label": "Download research", "hold": 5, "flag": "dl", "text": "Research downloaded" } ], "trigger": { "type": "flag", "name": "dl" } },
        { "text": "Destroy the radar dome", "checkpoint": true, "actions": [ { "do": "unmarker", "id": "l" }, { "do": "marker", "id": "r", "pos": [420, 300], "label": "Radar" }, { "do": "radio", "who": "Command", "text": "Now blind them. C4 on the radar dome, or set the demolition charge by hand." }, { "do": "interact", "pos": [425, 300], "label": "Set demolition charge", "hold": 3, "flag": "radarc", "text": "Charge set — 10 seconds" } ], "trigger": { "type": "any", "of": [ { "type": "destroy", "id": "radar" }, { "type": "flag", "name": "radarc" } ] }, "after": [ { "do": "structure", "id": "radar", "collapse": true } ] },
        { "text": "Exfiltrate to the fuel depot", "checkpoint": true, "actions": [ { "do": "unmarker", "id": "r" }, { "do": "marker", "id": "x", "pos": [-450, -350], "label": "Pickup" }, { "do": "spawn", "n": 8, "pos": [850, -760], "r": 20, "team": 1, "tag": "qrf", "hunt": true, "difficulty": "hardened" }, { "do": "radio", "who": "Command", "text": "Their quick-reaction force is up. Pickup at the fuel depot." } ], "trigger": { "type": "reach", "pos": [-450, -350], "r": 45 }, "after": [ { "do": "win" } ] }
      ]
    },
    {
      "id": "m4", "name": "Floodgate", "map": "greywood", "variant": "rain", "start": [-700, -700], "yaw": 1.6, "squad": 3, "par": 1000,
      "brief": "The Mandate has mined the Greywood dam and will blow it on their own schedule — unless they lose it first. The valley below is evacuated. Take the dam works, set charges on both spillways, and release the reservoir before their armour can cross the valley.",
      "debrief": "The flood cut the Mandate's armour off from the coast. Their command is falling back to Skyline's towers in Port Aurel.",
      "loadout": { "throwables": { "frag": 2, "smoke": 2 } },
      "steps": [
        { "text": "Reach the dam works", "actions": [ { "do": "cine", "title": "FLOODGATE", "sub": "Greywood, Valmora · 15:00" }, { "do": "marker", "id": "w", "pos": [230, -700], "label": "Dam works" }, { "do": "spawn", "n": 4, "pos": [-300, -600], "r": 20, "team": 1, "tag": "pat", "goal": { "type": "defend", "pos": [-300, -600], "r": 40 } }, { "do": "radio", "who": "Command", "text": "Through the forest, along the reservoir. The dam works are on the east bank." } ], "trigger": { "type": "reach", "pos": [200, -690], "r": 50 } },
        { "text": "Clear the dam works", "checkpoint": true, "actions": [ { "do": "spawn", "n": 8, "pos": [230, -700], "r": 30, "team": 1, "tag": "dw", "goal": { "type": "defend", "pos": [230, -700], "r": 30 } } ], "trigger": { "type": "alive", "tag": "dw", "max": 1 } },
        { "text": "Set charges on both spillways", "checkpoint": true, "actions": [ { "do": "unmarker", "id": "w" }, { "do": "marker", "id": "c1", "pos": [-120, -650], "label": "West spillway" }, { "do": "marker", "id": "c2", "pos": [120, -650], "label": "East spillway" }, { "do": "interact", "pos": [-120, -650, "top"], "label": "Set charge (west)", "hold": 3, "flag": "c1", "text": "West charge set" }, { "do": "interact", "pos": [120, -650, "top"], "label": "Set charge (east)", "hold": 3, "flag": "c2", "text": "East charge set" }, { "do": "spawn", "n": 7, "pos": [700, -900], "r": 20, "team": 1, "tag": "rf", "difficulty": "regular", "goal": { "type": "attack", "pos": [0, -650], "r": 30 } }, { "do": "spawnVehicle", "id": "hover_tank", "pos": [900, -1000], "team": 1, "tag": "tank", "crew": 2, "goal": { "type": "attack", "pos": [100, -700], "r": 40 } } ], "trigger": { "type": "all", "of": [ { "type": "flag", "name": "c1" }, { "type": "flag", "name": "c2" } ] } },
        { "text": "Get to high ground — 20 seconds", "actions": [ { "do": "unmarker", "id": "c1" }, { "do": "unmarker", "id": "c2" }, { "do": "marker", "id": "h", "pos": [-700, -700], "label": "High ground" }, { "do": "radio", "who": "Command", "text": "Charges armed. Off the dam, now!" }, { "do": "music", "level": 1 } ], "trigger": { "type": "timer", "t": 20 }, "after": [ { "do": "structure", "id": "dam", "collapse": true }, { "do": "radio", "who": "Command", "text": "There it goes. Watch the valley." } ] },
        { "text": "Reach the lodge", "checkpoint": true, "actions": [], "trigger": { "type": "reach", "pos": [-700, -700], "r": 70 }, "after": [ { "do": "win" } ] }
      ]
    },
    {
      "id": "m5", "name": "Glass Ceiling", "map": "skyline", "variant": "night", "start": [-760, 700], "yaw": 2.3, "squad": 3, "par": 900,
      "brief": "Director Senn runs the Mandate's Port Aurel operation from a penthouse above the city. A dropship will put you on the rooftops; from there it is grapples, jetpacks and nerve. Recommended operators: Wren (grapple) or Kestrel (jetpack).",
      "debrief": "Senn's files show a freighter of missiles leaving Harbourfront tonight.",
      "steps": [
        { "text": "Ride the dropship in", "actions": [ { "do": "cine", "title": "GLASS CEILING", "sub": "Skyline, Port Aurel · 22:30" }, { "do": "spawnVehicle", "id": "vtol_dropship", "pos": [-730, 690], "yaw": 2.4, "team": 0, "faction": "accord", "tag": "ds", "crew": 1, "goal": { "type": "move", "pos": [40, -10], "r": 20 }, "player": true, "playerSeat": 3 }, { "do": "host", "fn": "squadBoard", "vtag": "ds" }, { "do": "radio", "who": "Pilot", "text": "Two minutes. I can't hold a hover near the spire — be ready to jump." } ], "trigger": { "type": "any", "of": [ { "type": "vehicleAt", "vtag": "ds", "pos": [40, -10], "r": 70 }, { "type": "timer", "t": 120 } ] } },
        { "text": "Jump — get onto the rooftops", "checkpoint": true, "actions": [ { "do": "radio", "who": "Pilot", "text": "Green light! Go, go!" }, { "do": "host", "fn": "squadDismount" } ], "trigger": { "type": "not", "of": { "type": "vehicle" } } },
        { "text": "Take the penthouse", "checkpoint": true, "actions": [ { "do": "marker", "id": "p", "pos": [100, -40], "label": "Penthouse" }, { "do": "spawn", "n": 9, "pos": [100, -40], "r": 30, "team": 1, "tag": "ph", "difficulty": "regular", "goal": { "type": "defend", "pos": [100, -40], "r": 30 } }, { "do": "spawn", "n": 1, "pos": [100, -40], "r": 4, "team": 1, "tag": "senn", "boss": true, "name": "Director Senn", "weapons": ["lynx"], "difficulty": "veteran", "goal": { "type": "defend", "pos": [100, -40], "r": 12 } } ], "trigger": { "type": "kill", "tag": "senn" } },
        { "text": "Reach the extraction rooftop", "checkpoint": true, "actions": [ { "do": "unmarker", "id": "p" }, { "do": "marker", "id": "x", "pos": [60, -60], "label": "Spire — pickup" }, { "do": "radio", "who": "Pilot", "text": "Senn is down. I'll come around the spire for you." }, { "do": "spawn", "n": 6, "pos": [560, -760], "r": 20, "team": 1, "tag": "qrf", "hunt": true } ], "trigger": { "type": "reach", "pos": [60, -60], "r": 35 }, "after": [ { "do": "win" } ] }
      ]
    },
    {
      "id": "m6", "name": "Last Departure", "map": "harbourfront", "variant": "storm", "start": [-650, 820], "yaw": 1.57, "squad": 3, "par": 720,
      "brief": "The freighter Halvard is loading Mandate missiles at Harbourfront. If it clears the breakwater the missiles reach the front. Take an assault hovercraft through the escort boats, board the ship and sink it at the pier. You have twelve minutes.",
      "debrief": "The Halvard sank at her moorings. The missile chain now leads through the Ashkar Range — to a monastery the Mandate has turned into a vault.",
      "loadout": { "throwables": { "c4": 2, "frag": 2 } },
      "events": [ { "when": { "type": "time", "t": 720 }, "actions": [ { "do": "fail", "text": "The freighter cleared the breakwater" } ] }, { "when": { "type": "time", "t": 600 }, "actions": [ { "do": "radio", "who": "Command", "text": "Two minutes until they cast off!" } ] } ],
      "steps": [
        { "text": "Sink the escort boats", "actions": [ { "do": "cine", "title": "LAST DEPARTURE", "sub": "Harbourfront, Port Aurel · 16:00" }, { "do": "spawnVehicle", "id": "assault_hovercraft", "pos": [-650, 830], "yaw": 1.57, "team": 0, "tag": "hc", "player": true }, { "do": "host", "fn": "squadBoard", "vtag": "hc" }, { "do": "radio", "who": "Command", "text": "Three escort boats between you and the freighter. Clear them." }, { "do": "spawnVehicle", "id": "patrol_boat", "pos": [-250, 820], "yaw": -1.57, "team": 1, "tag": "pb", "crew": 2, "goal": { "type": "attack", "pos": [-600, 830], "r": 40 } }, { "do": "spawnVehicle", "id": "patrol_boat", "pos": [150, 880], "yaw": -1.57, "team": 1, "tag": "pb", "crew": 2, "goal": { "type": "attack", "pos": [-400, 830], "r": 40 } }, { "do": "spawnVehicle", "id": "patrol_boat", "pos": [400, 760], "yaw": -1.57, "team": 1, "tag": "pb", "crew": 2, "goal": { "type": "attack", "pos": [0, 800], "r": 40 } } ], "trigger": { "type": "destroy", "vtag": "pb", "count": 3 } },
        { "text": "Board the freighter", "checkpoint": true, "actions": [ { "do": "marker", "id": "f", "pos": [80, 620], "label": "Freighter" }, { "do": "spawn", "n": 8, "pos": [80, 620], "r": 30, "y": 30, "team": 1, "tag": "deck", "difficulty": "regular", "goal": { "type": "defend", "pos": [80, 620], "r": 40 } } ], "trigger": { "type": "reach", "pos": [80, 620], "r": 45 } },
        { "text": "Set charges: bow and stern", "checkpoint": true, "actions": [ { "do": "host", "fn": "squadDismount" }, { "do": "interact", "pos": [80, 560, "top"], "label": "Set charge (bow)", "hold": 3, "flag": "bow", "text": "Bow charge set" }, { "do": "interact", "pos": [80, 690, "top"], "label": "Set charge (stern)", "hold": 3, "flag": "stern", "text": "Stern charge set" }, { "do": "marker", "id": "c1", "pos": [80, 560], "label": "Bow" }, { "do": "marker", "id": "c2", "pos": [80, 690], "label": "Stern" } ], "trigger": { "type": "all", "of": [ { "type": "flag", "name": "bow" }, { "type": "flag", "name": "stern" } ] } },
        { "text": "Get off the ship — 15 seconds", "actions": [ { "do": "unmarker", "id": "f" }, { "do": "unmarker", "id": "c1" }, { "do": "unmarker", "id": "c2" }, { "do": "radio", "who": "Command", "text": "Charges hot. Jump, swim, run — just get clear!" } ], "trigger": { "type": "timer", "t": 15 }, "after": [ { "do": "structure", "id": "freighter", "collapse": true } ] },
        { "text": "Halvard is going down", "actions": [], "trigger": { "type": "timer", "t": 6 }, "after": [ { "do": "win" } ] }
      ]
    },
    {
      "id": "m7", "name": "The Long Cable", "map": "highpass", "variant": "cloud", "start": [-470, 470], "yaw": 2.5, "squad": 3, "par": 1100,
      "brief": "The monastery above Teral can only be reached by road through a Mandate fortress line — or by the old cable car. Clear the lower station, ride a cabin up under fire, storm the monastery and empty its vault.",
      "debrief": "The vault held the launch codes for the Mandate's last missile battery, dug into the Whiteout fortress. Time to finish this.",
      "steps": [
        { "text": "Clear the lower cable station", "actions": [ { "do": "cine", "title": "THE LONG CABLE", "sub": "Highpass, Ashkar Range · 09:00" }, { "do": "marker", "id": "s", "pos": [-400, 380], "label": "Lower station" }, { "do": "spawn", "n": 6, "pos": [-400, 380], "r": 20, "team": 1, "tag": "ls", "goal": { "type": "defend", "pos": [-400, 380], "r": 25 } } ], "trigger": { "type": "alive", "tag": "ls", "max": 0 } },
        { "text": "Ride the cable car to the monastery", "checkpoint": true, "actions": [ { "do": "unmarker", "id": "s" }, { "do": "marker", "id": "t", "pos": [270, -360], "label": "Upper station" }, { "do": "radio", "who": "Command", "text": "Get in a cabin. Shooters on the ridge will try to stop you — return fire." }, { "do": "spawn", "n": 6, "pos": [60, -150], "r": 30, "team": 1, "tag": "ridge", "goal": { "type": "defend", "pos": [60, -150], "r": 30 } } ], "trigger": { "type": "reach", "pos": [270, -360], "r": 40 } },
